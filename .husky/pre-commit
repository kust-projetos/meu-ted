# Fast commit gate: validates the staged diff only (conflict markers,
# structured-file syntax, secret-looking filenames, oversized files).
#
# Area-specific gates (docs, governance, capabilities, write-policy, boundary,
# workflow pins) are opt-in: run `pnpm check:area` before opening a PR, or let
# the PR CI run them when the matching area changes.
#
# Emergency bypass: git commit --no-verify (justify it in the PR description).
set -e

pnpm commit:check
