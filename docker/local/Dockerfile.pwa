# PWA local (next standalone). Build da raiz do repo:
# docker build -f docker/local/Dockerfile.pwa .
FROM node:22-alpine AS builder
RUN npm install -g pnpm@10.34.1
WORKDIR /monorepo
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/llm-contracts/package.json packages/llm-contracts/package.json
COPY apps/pwa/package.json apps/pwa/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/agent/package.json apps/agent/package.json
COPY apps/codex-broker/package.json apps/codex-broker/package.json
RUN pnpm install --frozen-lockfile
COPY packages/llm-contracts packages/llm-contracts
COPY apps/pwa apps/pwa
RUN pnpm --filter @pi-finance/llm-contracts build
# NEXT_PUBLIC_* é inlined no build; o client usa o proxy same-origin
# (/api/backend -> PWA_BACKEND_PROXY_ORIGIN em runtime), então nenhum
# build-arg é necessário para o fluxo local.
RUN pnpm --filter pwa build

FROM node:22-alpine AS runner
WORKDIR /app/apps/pwa
COPY --from=builder /monorepo/apps/pwa/.next/standalone/apps/pwa ./
COPY --from=builder /monorepo/apps/pwa/.next/standalone/node_modules /app/node_modules
COPY --from=builder /monorepo/apps/pwa/.next/static ./.next/static
COPY --from=builder /monorepo/apps/pwa/public ./public
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
# O server.js standalone força NODE_ENV='production', o que desabilita em
# runtime o escape hatch de dev (ALLOW_LOCAL_ORIGIN) mesmo com a env setada
# no compose. Preserva o valor vindo do ambiente (development no local);
# sem ele, POSTs same-origin no proxy caem em csrf.origin_mismatch porque
# request.url chega com host 0.0.0.0 (trustHostHeader:false) e o bypass
# nunca liga. Local-only: produção usa Cloudflare/OpenNext, não esta imagem.
RUN sed -i "s/^process\.env\.NODE_ENV = 'production'$/if (!process.env.NODE_ENV) process.env.NODE_ENV = 'production'/" server.js && grep -n "NODE_ENV" server.js
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --spider --quiet http://127.0.0.1:3000/ || exit 1
CMD ["node", "server.js"]
