{
  "name": "@pi-finance/llm-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared isomorphic LLM governance contracts (pure types + zod schemas). No server-side imports allowed.",
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/index.js" },
    "./types": { "types": "./src/types.ts", "default": "./dist/types.js" },
    "./schemas": { "types": "./src/schemas.ts", "default": "./dist/schemas.js" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
