# Standalone VPS production Dockerfile for pi-finance-api.
# Manual release process: see docs/agent/2026-08-31-invites-workspace.md
# ("Mecanismo de release da API") and docs/ops/vps-access.md.
#
# Build context (staging dir, mirrored at ~/infra/pi-finance-api/app on the VPS):
#   package.json, pnpm-lock.standalone.yaml, pnpm-workspace.yaml  (api package as workspace root)
#   packages/llm-contracts/                            (workspace member vendored from packages/)
#   src/, tests/, scripts/, tsconfig*.json, ...        (apps/api files at root)
#
# Determinism (2026-09-06 login outage): this build MUST use
# `pnpm install --frozen-lockfile` against the versioned
# `pnpm-lock.standalone.yaml` (copied into the context as `pnpm-lock.yaml`).
# Rationale: `--no-frozen-lockfile` once resolved `better-auth@^1.6.26` to 1.7.3
# in production while the repo pinned 1.6.30, shipping a startup schema-check
# the code was not written for. The exact pin (`better-auth: 1.6.30`, no `^`,
# in package.json) is still required: a fresh standalone lockfile resolves
# ranges anew, so frozen alone would just freeze whatever is newest.
# Sync note: `pnpm-lock.standalone.yaml` lives next to this file in git and
# is synced to the staging dir UNDER THE SAME NAME (no rename at sync time);
# the COPY below maps it to `./pnpm-lock.yaml` inside the image, so Dockerfile
# and staging context coincide by construction.
#
# Differs from apps/api/Dockerfile, which builds from the monorepo root.
# The workspace wrapper exists so the `workspace:*` dependency on
# @pi-finance/llm-contracts resolves inside the standalone context.

FROM node:24-alpine
# CVE-2026-14456 libcrypto3/libssl3 3.5.7-r0 -> 3.5.8-r0: force upgrade on alpine 3.24
RUN apk update && apk upgrade --no-cache libcrypto3 libssl3
RUN npm install -g pnpm@10.34.1
WORKDIR /app

# Install first (layer cached) — workspace file + member manifests must
# precede install so `workspace:*` resolves to ./packages/llm-contracts.
# The lockfile is copied under its resolved name; see determinism note above.
COPY package.json pnpm-workspace.yaml ./
COPY pnpm-lock.standalone.yaml ./pnpm-lock.yaml
COPY packages ./packages
RUN pnpm install --frozen-lockfile --ignore-scripts=false
RUN pnpm --filter @pi-finance/llm-contracts build

# Trivy flags undici bundled with the npm CLI (node:24-alpine ships npm in the
# base image). The runtime below runs `node --import tsx` directly — it never
# needs npm/npx/pnpm — so drop the bundled npm CLI and the global pnpm install
# after dependencies resolve (same policy as apps/api/Dockerfile final stage).
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/pnpm \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/pnpm /usr/local/bin/pnpx

# Copy API source (tsx runtime, no build step).
COPY . .

EXPOSE 3001
ENV NODE_ENV=production
ENV MIGRATIONS_MODE=disabled
CMD ["node", "--import", "tsx", "src/server/index.ts"]
