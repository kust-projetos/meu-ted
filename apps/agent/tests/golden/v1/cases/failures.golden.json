      "title": "Falha na tool de proposta: erro propaga, nada criado, nada alegado",
      "workflow": "tool-failure",
      "status": "executable",
      "initialState": {
        "accounts": [
          {
            "id": "11111111-1111-4111-8111-111111111111",
