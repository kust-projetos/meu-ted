      "id": "GW-035",
      "title": "Extrato com dados responde com os valores reais, nunca ausência",
      "workflow": "statement-with-data",
      "status": "executable",
      "initialState": {
        "reads": "ok-data",
        "readData": {
          "transactions": [
            {
              "description": "Carne",
              "date": "2026-01-15",
              "amountCents": 5000
            }
          ]
        }
      },
      "inputs": [
        {
          "text": "qual meu extrato de janeiro?",
          "intentionId": "intent-stmt-data-1"
        }
      ],
      "expectations": {
        "expectedActions": ["read_answered"],
        "forbiddenActions": ["proposal_created", "confirmation_executed"],
        "backend": {
          "proposalsCreated": 0,
          "executionsSucceeded": 0,
          "maxLedgerEntries": 0
        },
        "response": {
          "mustMatch": ["extrato", "Carne"],
          "mustNotMatch": ["registrado", "com sucesso", "Não há"]
        },
        "budget": { "maxTurns": 2 }
      }
    },
