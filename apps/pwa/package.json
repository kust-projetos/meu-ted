{
  "name": "pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "start:standalone": "node e2e/standalone-server.mjs",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:stable": "vitest run --coverage.enabled=false",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "build:next:cloudflare": "next build --webpack",
    "build:cloudflare": "pnpm build:next:cloudflare && node scripts/prepare-standalone.mjs && pnpm opennextjs-cloudflare build --skipBuild",
    "preview": "pnpm build:cloudflare && wrangler dev",
    "deploy": "pnpm build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@pi-finance/llm-contracts": "workspace:*",
    "@serwist/next": "9.5.11",
    "@serwist/precaching": "9.5.11",
    "@serwist/sw": "9.5.11",
    "lucide-react": "^1.35.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "9.5.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^8.0.0",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
