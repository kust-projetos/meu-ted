# P2D local dev bindings (no secrets): synthetic HOUSEHOLD_A + loopback gateway.
# Loaded only by local Next/wrangler dev; production uses wrangler.jsonc vars.
# Required because the #306 activation needs an explicit workspace allowlist.
TED_OPENCODE_RUNTIME_ENABLED=1
TED_OPENCODE_WORKSPACES=00000000-0000-4000-8000-00000000000a
TED_OPENCODE_GATEWAY_ORIGIN=http://127.0.0.1:3221
