{
  "name": "meu-ted",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Finance PWA, API and Agent monorepo.",
  "scripts": {
    "dev": "pnpm --filter pwa dev",
    "start": "pnpm --filter pwa start",
    "build": "pnpm --filter meu-ted-api build && pnpm --filter pi-finance-agent build && pnpm --filter pi-finance-codex-broker build && pnpm --filter pwa build",
    "build:pwa": "pnpm --filter pwa build:cloudflare",
    "dev:pwa": "pnpm --filter pwa dev",
    "start:pwa": "pnpm --filter pwa start",
    "pwa:prod": "node scripts/start-pwa-standalone.mjs",
    "pwa:prod:3002": "PORT=3002 node scripts/start-pwa-standalone.mjs",
    "build:api": "pnpm --filter meu-ted-api build",
    "dev:api": "pnpm --filter meu-ted-api dev",
    "typecheck": "node scripts/run-workspace-gate.mjs typecheck",
    "test": "pnpm --filter meu-ted-api test && pnpm --filter pi-finance-agent test && pnpm --filter pi-finance-codex-broker test && pnpm --filter pwa test",
    "test:pwa": "pnpm --filter pwa test",
    "test:api": "pnpm --filter meu-ted-api test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm --filter meu-ted-api lint && pnpm --filter pi-finance-agent lint && pnpm --filter pi-finance-codex-broker lint && pnpm --filter pwa lint",
    "test:unit": "pnpm --filter meu-ted-api test && pnpm --filter pwa test",
    "test:integration": "pnpm --filter meu-ted-api test:integration",
    "test:e2e": "pnpm --filter pwa test",
    "build:all": "pnpm --filter meu-ted-api build && pnpm --filter pi-finance-agent build && pnpm --filter pi-finance-codex-broker build && pnpm --filter pwa build",
    "security:secrets": "node scripts/security-secrets.mjs",
    "public-safety": "node scripts/check-public-safety.mjs",
    "security:deps": "pnpm audit --audit-level=critical",
    "security:containers": "node scripts/security-containers.mjs",
    "container:smoke": "node scripts/container-smoke.mjs",
    "security:check": "node scripts/security-secrets.mjs && pnpm audit --audit-level=critical && node scripts/security-containers.mjs",
    "capabilities:check": "node scripts/check-tool-capability-inventory.mjs",
    "architecture:check": "node scripts/check-agent-v2-invariants.mjs",
    "write-policy:check": "node scripts/check-write-policy.mjs",
    "governance:check": "node scripts/check-decision-governance.mjs",
    "boundary:check": "node scripts/check-pwa-command-boundary.mjs",
    "docs:lint": "node scripts/lint-docs.mjs",
    "plans:check": "node scripts/check-active-plan-status.mjs",
    "production:smoke:contract": "node --test scripts/production-smoke-contract.test.mjs",
    "test:skip-gate": "node scripts/check-test-skips.mjs",
    "action-pins:check": "node scripts/check-action-pins.mjs",
    "validate:final": "node scripts/run-final-validation.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "next>sharp": "0.34.5",
      "vite": ">=7.3.5",
      "postcss": ">=8.5.18",
      "qs": ">=6.15.2",
      "tmp": ">=0.2.3",
      "uuid": ">=9.0.0",
      "brace-expansion@^1": "1.1.21",
      "brace-expansion@^2": "2.1.7",
      "brace-expansion@^3": "3.0.9",
      "brace-expansion@^5": "5.0.12",
      "browserslist": ">=4.28.7",
      "fast-uri": ">=4.1.3",
      "find-my-way": ">=9.7.0",
      "ip-address": ">=10.3.1",
      "nanoid@^3": "3.3.18",
      "picomatch@^2": ">=2.3.2",
      "picomatch@^3": ">=3.0.2",
      "picomatch@^4": ">=4.0.4",
      "undici@^7": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "next"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  }
}
